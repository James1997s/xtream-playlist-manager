<includes>
    <include name="Background">
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>background.jpg</texture><aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>colors/black.png</texture><colordiffuse>CC08111F</colordiffuse>
        </control>
    </include>
    <include name="Header">
        <control type="label">
            <left>92</left><top>52</top><width>1200</width><height>54</height>
            <font>Title</font><textcolor>White</textcolor><label>$INFO[System.CurrentWindow]</label>
        </control>
        <control type="label">
            <left>1550</left><top>60</top><width>280</width><height>42</height>
            <font>Small</font><textcolor>Mint</textcolor><align>right</align><label>$INFO[System.Time]</label>
        </control>
    </include>
    <include name="Tile">
        <control type="image">
            <left>0</left><top>0</top><width>360</width><height>210</height>
            <texture>colors/black.png</texture><colordiffuse>FF102A49</colordiffuse>
            <animation effect="fade" start="0" end="100" time="180">Focus</animation>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>8</width><height>210</height><texture>colors/white.png</texture><colordiffuse>FF4DE1C1</colordiffuse>
        </control>
        <control type="label">
            <left>30</left><top>118</top><width>300</width><height>48</height>
            <font>Tile</font><textcolor>White</textcolor><label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
            <left>30</left><top>168</top><width>300</width><height>28</height>
            <font>Small</font><textcolor>Muted</textcolor><label>$INFO[ListItem.Label2]</label>
        </control>
    </include>
    <include name="Footer">
        <control type="label">
            <left>92</left><top>1004</top><width>1700</width><height>30</height>
            <font>Small</font><textcolor>Muted</textcolor><label>XTREAM NEON  •  $INFO[System.FriendlyName]</label>
        </control>
    </include>
</includes>
